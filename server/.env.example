# Abuse.ch URLhaus API key. Keep this on the server only.
URLHAUS_AUTH_KEY=

# Optional shared key between the extension and API.
# This is a demo/access-control key, not a secret: browser extensions cannot hide client-side values.
EXTENSION_API_KEY=

# Optional CORS restriction. Leave as * for local/SIH demo, or set the exact extension origin after loading it.
EXTENSION_ALLOWED_ORIGIN=*
